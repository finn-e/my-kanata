;; Kanata config
;; layout - jk/by
;; Fin o'Flaherty
;; 2025-07-26
;; 🄯 Unlicense

(defcfg 
  linux-dev /dev/input/by-path/platform-i8042-serio-0-event-kbd
  linux-output-device-name "kanata output - ja layout"
  process-unmapped-keys yes
  concurrent-tap-hold true
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rctl
)

(deflayer default
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX   XX 
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX
       XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  @key XX   XX   XX                            XX   XX
)

(deflayer qwerty
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  @key    lmet lalt           spc            ralt rctl
)

(deflayer jkby
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX   XX 
  @j   @k   @b   @y   XX   XX   XX   XX        XX   @c   @l   @f   @w   @w
  @a   @i   @o   @e   XX   XX   XX   XX        XX   @d   @n   @s   @r  
       @x   @p   @u   XX   XX   XX   XX   XX   XX   @g   @m   @v
       @key lmet @kr  @spc                     @t   @h
)

(deflayer choice
  @def @def @def @def @def @def @def @def      @def @def @def @def @def @def 
  @def @def @def @def @def @def @def @def      @def @def @def @def @def @def
  @def @def @def @qwe @def @def @def @def      @def @jk  @def @def @def
       @def @def @def @def @def @def @def @def @def @def @def @def
       _    @def @def @def                          @def @def

)

(deflayer navigation
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX   XX 
  @hom @pgd @pgu @end XX   XX   XX   XX        XX   @hom @pgu @pgd @end XX
  left down up  right XX   XX   XX   XX        XX   left up   down right
       left down right XX  XX   XX   XX   XX   XX   left down right
       _    _    _    _                        _    _
)

(deflayer numbers
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX   XX 
  XX   7    8    9    XX   XX   XX   XX        XX   7    8    9    XX   XX
  0    4    5    6    XX   XX   XX   XX        XX   4    5    6    0  
       1    2    3    XX   XX   XX   XX   XX   XX   1    2    3
       _    _    _    _                        _    _
)

(deflayer symbols
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX   XX 
  XX   S-7  S-8  S-9  XX   XX   XX   XX        XX   S-7  S-8  S-9  XX   XX
  S-0  S-4  S-5  S-6  XX   XX   XX   XX        XX   S-4  S-5  S-6  S-0
       S-1  S-2  S-3  XX   XX   XX   XX   XX   XX   S-1  S-2  S-3
       _    _    _    _                        _    _
)

(deflayer functions1
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX   XX 
  F22  F7   F8   F9   XX   XX   XX   XX        XX   F7   F8   F9   F22  F22
  F10  F4   F5   F6   XX   XX   XX   XX        XX   F4   F5   F6   F10
       F1   F2   F3   XX   XX   XX   XX   XX   XX   F1   F2   F3
       _    _    _    _                        _    _
)

(deflayer functions2
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX   XX 
  F21  F15  F16  F17  XX   XX   XX   XX        XX   F17  F16  F15  F21  F21
  F20  F14  F15  F16  XX   XX   XX   XX        XX   F14  F15  F16  F20
       F11  F12  F13  XX   XX   XX   XX   XX   XX   F11  F12  F13
       _    _    _    _                        _    _
)

(deflayer miscellaneous
  XX   XX   XX   XX   XX   XX   XX   XX        XX   XX   XX   XX   XX   XX 
  XX   @vdn @vup @vmu XX   XX   XX   XX        XX   @vmu @vup @vdn XX   XX
  XX   C-x  C-c  C-v  XX   XX   XX   XX        XX   C-v  C-c  C-x  XX
       C-z C-S-z C-s  XX   XX   XX   XX   XX   XX   C-s C-S-z C-z
       _    _    _    _                        _    _
)

(defalias ;; other alii
  hom (tap-hold-release 200 200 home lmet)
  pgd (tap-hold-release 200 200 pgdn lalt)
  pgu (tap-hold-release 200 200 pgup lctl)
  end (tap-hold-release 200 200 end lsft)
  vup VolumeUp
  vdn VolumeDown
  vmu VolumeMute
)

(defalias ;; layers
  def (layer-switch default)
  qwe (layer-switch qwerty)
  jk  (layer-switch jkby) 
  cho (layer-switch choice)
  nav (layer-while-held navigation)
  num (layer-while-held numbers)
  fn1 (layer-while-held functions1)
  fn2 (layer-while-held functions2)
  msc (layer-while-held miscellaneous)
  sym (layer-while-held symbols)
  key (tap-hold-release 200 200 @cho lctl)
)

(defalias ;; words
  the (macro t (unshift h) (unshift e))
  you (macro y (unshift o) (unshift u))
  and (macro a (unshift n) (unshift d))
  bc (macro b (unshift e) (unshift c) (unshift a) (unshift u) (unshift s) (unshift e))
)

(defalias ;; main-keys
  ;; top row
  j (tap-hold-release 200 200 j @msc)
  k (tap-hold-release 200 200 k @fn2)
  b (tap-hold-release 200 200 b @fn1)
  y y
  c c
  l (tap-hold-release 200 200 l @fn1)
  f (tap-hold-release 200 200 f @fn2)
  w (tap-hold-release 200 200 w @msc)
  ;; home row
  a (tap-hold-release 200 200 a lmet)
  i (tap-hold-release 200 200 i lalt)
  o (tap-hold-release 200 200 o lctl)
  e (tap-hold-release 200 200 e lsft)
  d (tap-hold-release 200 200 d rsft)
  n (tap-hold-release 200 200 n rctl)
  s (tap-hold-release 200 200 s lalt)
  r (tap-hold-release 200 200 r rmet)
  ;; bottom row
  x (tap-hold-release 200 200 x ralt)
  p (tap-hold-release 200 200 p @msc)
  u (tap-hold-release 200 200 u @sym)
  g (tap-hold-release 200 200 g @sym)
  m (tap-hold-release 200 200 m @msc)
  v (tap-hold-release 200 200 v ralt)
  kr (tap-hold-release 200 200 rpt-any @num)
  spc (tap-hold-release 200 200 Space @nav)
  t (tap-hold-release 200 200 t @nav)
  h (tap-hold-release 200 200 h @num)
)

(defchordsv2
  ;; Left hand verts
  (tab caps) ins 50 all-released (default qwerty choice)
  (q a) caps 50 all-released (default qwerty choice)
  (w s) (caps-word 500) 50 all-released (default qwerty choice)
  (e d)  S-9 50 all-released (default qwerty choice)
  (a lsft)  C-x 50 all-released (default qwerty choice)
  (s z)  C-c 50 all-released (default qwerty choice)
  (d x)  C-v 50 all-released (default qwerty choice)
  ;; Right hand verts
  (l o)  S-0 50 all-released (default qwerty choice)
  (; p)  (caps-word 500) 50 all-released (default qwerty choice)
  (' [)  caps 50 all-released (default qwerty choice)
  (] ret)  ins 50 all-released (default qwerty choice)
  (l .)  C-v 50 all-released (default qwerty choice)
  (; /)  C-c 50 all-released (default qwerty choice)
  (' rsft)  C-x 50 all-released (default qwerty choice)
  ;; Left Top Horizontals
  (tab q    )  (one-shot 500 (layer-while-held miscellaneous)) 50 all-released (default qwerty choice)
  (tab   w  )  S-tab  50 all-released (default qwerty choice)
  (tab     e)  ret 50 all-released (default qwerty choice)
  (    q w  )  (one-shot 500 (layer-while-held jkby)) 50 all-released (default qwerty choice) ;; bt on bt kbs 
  (    q   e)  tab 50 all-released (default qwerty choice)
  (      w e)  (one-shot 500 (layer-while-held symbols)) 50 all-released (default qwerty choice)
  ;; Right Top Horizontals
  (o p    )  (one-shot 500 (layer-while-held symbols)) 50 all-released (default qwerty choice)
  (o   [  )  tab 50 all-released (default qwerty choice)
  (o     ])  ret 50 all-released (default qwerty choice)
  (p   [  )  (one-shot 500 (layer-while-held jkby)) 50 all-released (default qwerty choice) ;; bt on bt kbs
  (p     ])  S-tab 50 all-released (default qwerty choice)
  (    [ ])  (one-shot 500 (layer-while-held miscellaneous)) 50 all-released (default qwerty choice)
  ;; Left Home Horizontals
  (caps a    )  ' 50 all-released (default qwerty choice)
  (caps   s  )  \ 50 all-released (default qwerty choice)
  (caps     d)  ; 50 all-released (default qwerty choice)
  (     a s  )  , 50 all-released (default qwerty choice)
  (     a   d)  S-/ 50 all-released (default qwerty choice)
  (       s d)  S-- 50 all-released (default qwerty choice)
  ;; Right Home Horizontals
  (l ;      )  - 50 all-released (default qwerty choice)
  (l   '    )  S-1 50 all-released (default qwerty choice)
  (l     ret)  : 50 all-released (default qwerty choice)
  (  ; '    )  . 50 all-released (default qwerty choice)
  (  ;   ret)  / 50 all-released (default qwerty choice)
  (    ' ret)  S-' 50 all-released (default qwerty choice)
  ;; Left Bottom Horizontals
  (. /     )  bspc 50 all-released (default qwerty choice)
  (.   rsft)  del 50 all-released (default qwerty choice)
  (  / rsft)  esc 50 all-released (default qwerty choice)
  (. / rsft)  prtsc 50 all-released (default qwerty choice)
  ;; Right Bottom Horizontals
  (lsft z  )  esc 50 all-released (default qwerty choice)
  (lsft   x)  del 50 all-released (default qwerty choice)
  (     z x)  bspc 50 all-released (default qwerty choice)
  (lsft z x)  prtsc 50 all-released (default qwerty choice)
  ;; Left brackets, uncommon letters &c
  (caps q )  lbrc 50 all-released (default qwerty choice)
  (tab a  )  S-lbrc 50 all-released (default qwerty choice)
  (  q   
       s  )  S-, 50 all-released (default qwerty choice)
  (    w  
     a    )  S-\  50 all-released (default qwerty choice)
  (      e
       s  )  j 50 all-released (default qwerty choice)
  (    w  
         d)  q 50 all-released (default qwerty choice)
  ;; Right brackets, uncommon letters &c
  (  p    
   l        )  z 50 all-released (default qwerty choice)
  (o      
     ;      )  x 50 all-released (default qwerty choice)
  (  p    
       '    )  S-7 50 all-released (default qwerty choice)
  (    [
     ;      )  S-. 50 all-released (default qwerty choice)
  (      ]
       '    )  S-rbrc 50 all-released (default qwerty choice)
  (    [  
         ret)  rbrc 50 all-released (default qwerty choice)
  ;; thumbs
  (lalt spc )  @you 50 all-released (default qwerty choice)
  (ralt rctl)  @the 50 all-released (default qwerty choice)
  (spc ralt )  @and 50 all-released (default qwerty choice)
  (lalt rctl)  @bc 50 all-released (default qwerty choice)
)
